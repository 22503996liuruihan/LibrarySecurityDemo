@model LibraryBackendMVC.Models.Borrowal

@{
    ViewData["Title"] = "Delete Borrow Record";
}

<h2 class="mb-4">Delete Borrow Record</h2>

<h3 class="text-danger">确定要删除这条借阅记录吗？</h3>

<div class="card p-3 my-4">
    <p><strong>记录ID：</strong> @Model.Id</p>
    <p><strong>会员ID：</strong> @Model.MemberId</p>
    <p><strong>图书ID：</strong> @Model.ItemId</p>
    <p><strong>借阅时间：</strong> @Model.BorrowTime</p>
    <p><strong>归还时间：</strong> @Model.ReturnTime</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">确认删除</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">取消，返回列表</a>
</form>