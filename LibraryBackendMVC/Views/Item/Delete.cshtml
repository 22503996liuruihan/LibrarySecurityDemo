@model LibraryBackendMVC.Models.Item

@{
    ViewData["Title"] = "删除图书";
}

<h2 class="mb-4">确认删除</h2>
<p class="text-danger">确定要删除这本图书吗？此操作不可恢复！</p>

<div class="card p-3 mb-4">
    <p><strong>ID：</strong>@Model.Id</p>
    <p><strong>书名：</strong>@Model.Title</p>
    <p><strong>作者：</strong>@Model.Author</p>
    <p><strong>ISBN：</strong>@Model.Isbn</p>
    <p><strong>库存：</strong>@Model.Stock</p>
</div>

<form asp-action="DeleteConfirm">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">确认删除</button>
    <a asp-action="Index" class="btn btn-secondary">取消</a>
</form>