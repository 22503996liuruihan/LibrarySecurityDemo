@model LibraryBackendMVC.Models.Member

@{
    ViewData["Title"] = "编辑会员";
}

<h2 class="mb-4">编辑会员</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="UserName" class="form-label">用户名</label>
        <input asp-for="UserName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">密码</label>
        <input asp-for="Password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">保存修改</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
</form>