@model LibraryBackendMVC.Models.Member

@{
    ViewData["Title"] = "新增会员";
}

<h2 class="mb-4">新增会员</h2>

<form asp-action="Create">
    <div class="mb-3">
        <label asp-for="UserName" class="form-label">用户名</label>
        <input asp-for="UserName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">密码</label>
        <input asp-for="Password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">提交</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
</form>